---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ContactFormSection } from '@/sections/ContactFormSection';
import { siteImages } from '@/config/images';
import { reviews, TOTAL_REVIEW_COUNT } from '@/data/reviews';

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "J Smith Exterior Cleaning",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": String(TOTAL_REVIEW_COUNT),
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": reviews.map((review) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": review.author },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": String(review.rating),
      "bestRating": "5"
    },
    "reviewBody": review.text
  }))
};
---

<BaseLayout
  title="Reviews | J Smith Exterior Cleaning"
  description="Read genuine customer reviews for J Smith Exterior Cleaning. Rated 5 stars on Google by homeowners across Ayrshire for roof cleaning, pressure washing, and more."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Reviews", url: "/reviews" }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
  <div
    role="main"
    class="text-sm bg-white box-border caret-transparent leading-[20.3px] break-words md:text-[17px] md:leading-[24.65px]"
  >
    <!-- Hero Section -->
    <div class="relative text-sm box-border caret-transparent flex items-center justify-center leading-[20.3px] break-words h-[400px] md:text-[17px] md:h-[500px] md:leading-[24.65px] overflow-hidden">
      <div
        class="absolute inset-0 bg-no-repeat bg-cover bg-center"
        style={`background-image: url('${encodeURI(siteImages.showcase)}');`}
      />
      <div class="absolute inset-0 bg-black/50" />
      <div class="relative text-sm box-border caret-transparent z-10 leading-[20.3px] break-words text-center md:text-[17px] md:leading-[24.65px]">
        <h1 class="text-white text-4xl font-bold box-border caret-transparent leading-[50px] break-words uppercase font-thiccboi md:text-6xl md:leading-[70px] drop-shadow-lg">
          Customer Reviews
        </h1>
        <p class="text-white text-xl box-border caret-transparent leading-[28px] break-words mt-4 md:text-2xl md:leading-[32px] drop-shadow-lg">
          Rated 5 Stars on Google Across Ayrshire
        </p>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="relative text-sm items-center box-border caret-transparent flex justify-center leading-[20.3px] break-words px-5 py-10 md:text-[17px] md:leading-[24.65px] md:px-5 md:py-16">
      <div class="text-sm box-border caret-transparent grow leading-[20.3px] max-w-[1300px] break-words mx-auto md:text-[17px] md:leading-[24.65px]">
        <div class="text-center mb-10">
          <div class="flex items-center justify-center gap-1 mb-3">
            {[...Array(5)].map(() => (
              <svg class="text-yellow-400 w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
              </svg>
            ))}
          </div>
          <p class="text-neutral-700 text-lg font-figtree">
            5.0 out of 5, based on {TOTAL_REVIEW_COUNT} Google reviews
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {reviews.map((review) => (
            <div class="bg-neutral-50 border border-neutral-200 rounded-lg p-6">
              <div class="flex items-center gap-1 mb-3">
                {[...Array(review.rating)].map(() => (
                  <svg class="text-yellow-400 w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                  </svg>
                ))}
              </div>
              <p class="text-neutral-700 text-base mb-3 font-figtree">"{review.text}"</p>
              <p class="text-neutral-900 text-sm font-semibold">- {review.author}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Contact CTA Section -->
    <div class="relative text-sm items-center box-border caret-transparent flex justify-center leading-[20.3px] break-words px-5 py-10 bg-neutral-50 md:text-[17px] md:leading-[24.65px] md:px-5 md:py-16">
      <div class="text-sm box-border caret-transparent grow leading-[20.3px] max-w-[800px] break-words mx-auto md:text-[17px] md:leading-[24.65px]">
        <div id="contact">
          <ContactFormSection client:load />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
